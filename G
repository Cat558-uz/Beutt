	OpenBtn.MouseButton1Click:Connect(function()
		safeClickAnim(OpenBtn, OpenBtnOriginalSize)
		opened = not opened
		Main.Visible = opened
	end)

	local Tabs = {}

	-- Helper to copy element creation functions into a container (Page or Section Content)
	local function injectElementAPIs(container)
		local api = {}

		function api:AddButton(text, callback)
			local Btn = Instance.new("TextButton")
			Btn.Size = UDim2.new(1, -10, 0, 30)
			Btn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
			Btn.Text = text
			Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
			Btn.Font = Enum.Font.Gotham
			Btn.TextSize = 13
			Btn.AutoButtonColor = false
			Btn.Parent = container
			Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 6)
			local s = Btn.Size
			Btn.MouseButton1Click:Connect(function()
				safeClickAnim(Btn, s)
				pcall(callback)
			end)
			return Btn
		end

		function api:AddToggle(text, callback)
			local Toggle = Instance.new("TextButton")
			Toggle.Size = UDim2.new(1, -10, 0, 30)
			Toggle.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
			Toggle.TextColor3 = Color3.fromRGB(255, 255, 255)
			Toggle.Font = Enum.Font.Gotham
			Toggle.TextSize = 13
			Toggle.Text = text.." [OFF]"
			Toggle.AutoButtonColor = false
			Toggle.Parent = container
			Instance.new("UICorner", Toggle).CornerRadius = UDim.new(0, 6)
			local s = Toggle.Size
			local state = false
			Toggle.MouseButton1Click:Connect(function()
				state = not state
				Toggle.Text = text.." ["..(state and "ON" or "OFF").."]"
				local color = state and Color3.fromRGB(0, 255, 100) or Color3.fromRGB(50, 50, 50)
				TweenService:Create(Toggle, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundColor3 = color}):Play()
				safeClickAnim(Toggle, s)
				pcall(callback, state)
			end)
			return Toggle
		end

		function api:AddTextbox(placeholder, callback)
			local Box = Instance.new("TextBox")
			Box.Size = UDim2.new(1, -10, 0, 30)
			Box.PlaceholderText = placeholder or ""
			Box.Text = ""
			Box.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
			Box.TextColor3 = Color3.fromRGB(255, 255, 255)
			Box.Font = Enum.Font.Gotham
			Box.TextSize = 12
			Box.Parent = container
			Instance.new("UICorner", Box).CornerRadius = UDim.new(0, 6)
			Box.FocusLost:Connect(function(enter)
				if enter then
					pcall(callback, Box.Text)
				end
			end)
			return Box
		end

		function api:AddLabel(text)
			local Label = Instance.new("TextLabel")
			Label.Size = UDim2.new(1, -10, 0, 26)
			Label.BackgroundTransparency = 1
			Label.Text = text or ""
			Label.TextColor3 = Color3.fromRGB(255, 255, 255)
			Label.Font = Enum.Font.Gotham
			Label.TextSize = 12
			Label.TextXAlignment = Enum.TextXAlignment.Left
			Label.Parent = container
			return Label
		end

		function api:AddDropdown(title, list, callback)
			local Frame = Instance.new("Frame")
			Frame.Size = UDim2.new(1, -10, 0, 30)
			Frame.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
			Frame.Parent = container
			Instance.new("UICorner", Frame).CornerRadius = UDim.new(0, 6)

			local Btn = Instance.new("TextButton")
			Btn.Size = UDim2.new(1, 0, 1, 0)
			Btn.BackgroundTransparency = 1
			Btn.Text = (title or "") .. " ▼"
			Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
			Btn.Font = Enum.Font.Gotham
			Btn.TextSize = 13
			Btn.Parent = Frame
			local s = Btn.Size

			local DropFrame = Instance.new("Frame")
			DropFrame.Size = UDim2.new(1, -10, 0, 0)
			DropFrame.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
			DropFrame.Visible = false
			DropFrame.Parent = container
			Instance.new("UICorner", DropFrame).CornerRadius = UDim.new(0, 6)

			local ListLayout = Instance.new("UIListLayout", DropFrame)
			ListLayout.Padding = UDim.new(0, 4)

			for _, opt in ipairs(list or {}) do
				local OptBtn = Instance.new("TextButton")
				OptBtn.Size = UDim2.new(1, -10, 0, 25)
				OptBtn.BackgroundColor3 = Color3.fromRGB(55, 55, 55)
				OptBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
				OptBtn.Text = opt
				OptBtn.Font = Enum.Font.Gotham
				OptBtn.TextSize = 12
				OptBtn.Parent = DropFrame
				Instance.new("UICorner", OptBtn).CornerRadius = UDim.new(0, 6)
				local oSize = OptBtn.Size
				OptBtn.MouseButton1Click:Connect(function()
					safeClickAnim(OptBtn, oSize)
					pcall(callback, opt)
					DropFrame.Visible = false
					TweenService:Create(DropFrame, TweenInfo.new(0.18), {Size = UDim2.new(1, -10, 0, 0)}):Play()
				end)
			end

			Btn.MouseButton1Click:Connect(function()
				safeClickAnim(Btn, s)
				DropFrame.Visible = not DropFrame.Visible
				local size = DropFrame.Visible and (#(list or {}) * 30) or 0
				TweenService:Create(DropFrame, TweenInfo.new(0.2), {Size = UDim2.new(1, -10, 0, size)}):Play()
			end)

			return Frame, DropFrame
		end

		function api:AddSection(title)
			-- Section header button
			local SectionBtn = Instance.new("TextButton")
			SectionBtn.Size = UDim2.new(1, -10, 0, 30)
			SectionBtn.BackgroundColor3 = Color3.fromRGB(55, 55, 55)
			SectionBtn.Text = "▼ " .. (title or "")
			SectionBtn.Font = Enum.Font.GothamBold
			SectionBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
			SectionBtn.TextSize = 13
			SectionBtn.AutoButtonColor = false
			SectionBtn.Parent = container
			Instance.new("UICorner", SectionBtn).CornerRadius = UDim.new(0, 6)

			-- Content frame where elements inside the section will be parented
			local Content = Instance.new("Frame")
			Content.Size = UDim2.new(1, -10, 0, 0)
			Content.BackgroundTransparency = 1
			Content.Parent = container
			Content.Visible = false
			local layout = Instance.new("UIListLayout", Content)
			layout.Padding = UDim.new(0, 6)

			-- Section API: same element methods, but parent to Content
			local sectionAPI = {}

			function sectionAPI:AddButton(text, callback)
				return injectElementAPIs(Content).AddButton(text, callback)
			end
			function sectionAPI:AddToggle(text, callback)
				return injectElementAPIs(Content).AddToggle(text, callback)
			end
			function sectionAPI:AddTextbox(placeholder, callback)
				return injectElementAPIs(Content).AddTextbox(placeholder, callback)
			end
			function sectionAPI:AddLabel(text)
				return injectElementAPIs(Content).AddLabel(text)
			end
			function sectionAPI:AddDropdown(title2, list2, callback2)
				return injectElementAPIs(Content).AddDropdown(title2, list2, callback2)
			end
			function sectionAPI:AddSection(subTitle)
				-- nested section: parent inside Content
				local nested = injectElementAPIs(Content).AddSection(subTitle)
				return nested
			end

			-- Toggle visibility with animation
			SectionBtn.MouseButton1Click:Connect(function()
				Content.Visible = not Content.Visible
				local targetSize = Content.Visible and 120 or 0
				TweenService:Create(Content, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = UDim2.new(1, -10, 0, targetSize)}):Play()
				SectionBtn.Text = (Content.Visible and "▲ " or "▼ ") .. (title or "")
				safeClickAnim(SectionBtn, SectionBtn.Size)
			end)

			return sectionAPI
		end

		return api
	end

	function Tabs:CreateTab(name)
		local TabButton = Instance.new("TextButton")
		TabButton.Text = name
		TabButton.Size = UDim2.new(1, -10, 0, 30)
		TabButton.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
		TabButton.TextColor3 = Color3.fromRGB(255, 255, 255)
		TabButton.Font = Enum.Font.GothamBold
		TabButton.TextSize = 13
		TabButton.AutoButtonColor = false
		TabButton.Parent = TabHolder
		Instance.new("UICorner", TabButton).CornerRadius = UDim.new(0, 6)
		local TabButtonSize = TabButton.Size

		local Page = Instance.new("ScrollingFrame")
		Page.Size = UDim2.new(1, -10, 1, -10)
		Page.Position = UDim2.new(0, 5, 0, 5)
		Page.BackgroundTransparency = 1
		Page.Visible = false
		Page.CanvasSize = UDim2.new(0, 0, 0, 0)
		Page.ScrollBarThickness = 4
		Page.Parent = TabContent

		local PageLayout = Instance.new("UIListLayout", Page)
		PageLayout.Padding = UDim.new(0, 6)

		TabButton.MouseButton1Click:Connect(function()
			-- animate and open
			safeClickAnim(TabButton, TabButtonSize)
			for _, v in pairs(TabContent:GetChildren()) do
				if v:IsA("ScrollingFrame") then
					v.Visible = false
				end
			end
			Page.Visible = true
		end)

		-- return API bound to this Page
		local pageAPI = injectElementAPIs(Page)
		-- ensure first tab defaults visible when created
		if #TabContent:GetChildren() == 0 then
			Page.Visible = true
		end

		return pageAPI
	end

	return Tabs
end

return GhostUI
